        "# SISTEMA INFORMÁTICO DE UN BANCO\n",
        "# Curso: Sistemas Informáticos=\n",
        "\n",
        "from datetime import datetime\n",
        "\n",
        "# 1. ENTRADA: DATOS DEL CLIENTE\n",
        "\n",
        "print(\"=\" * 55)\n",
        "print(\"       SISTEMA INFORMÁTICO DE UN BANCO\")\n",
        "print(\"=\" * 55)\n",
        "\n",
        "nombre = input(\"Ingrese nombre del cliente: \")\n",
        "dni = input(\"Ingrese DNI: \")\n",
        "cuenta = input(\"Ingrese número de cuenta: \")\n",
        "\n",
        "while True:\n",
        "    try:\n",
        "        saldo = float(input(\"Ingrese saldo inicial (S/): \"))\n",
        "        if saldo >= 0:\n",
        "            break\n",
        "        print(\"El saldo no puede ser negativo.\")\n",
        "    except ValueError:\n",
        "        print(\"Ingrese un valor numérico válido.\")\n",
        "\n",
        "# Lista donde se almacenarán las operaciones\n",
        "operaciones = []\n",
        "\n",
        "# 2. PROCESO: REGISTRO DE OPERACIONES\n",
        "while True:\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 55)\n",
        "    print(\"                 MENÚ PRINCIPAL\")\n",
        "    print(\"=\" * 55)\n",
        "    print(\"1. Realizar depósito\")\n",
        "    print(\"2. Realizar retiro\")\n",
        "    print(\"3. Consultar saldo\")\n",
        "    print(\"4. Ver historial de operaciones\")\n",
        "    print(\"5. Ver estadísticas\")\n",
        "    print(\"6. Mostrar información del cliente\")\n",
        "    print(\"7. Salir\")\n",
        "\n",
        "    opcion = input(\"\\nSeleccione una opción: \")\n",
        "\n",
        "    # DEPÓSITO\n",
        "\n",
        "    if opcion == \"1\":\n",
        "\n",
        "        while True:\n",
        "            try:\n",
        "                monto = float(input(\"Ingrese monto a depositar (S/): \"))\n",
        "\n",
        "                if monto > 0:\n",
        "                    break\n",
        "\n",
        "                print(\"El monto debe ser mayor que 0.\")\n",
        "\n",
        "            except ValueError:\n",
        "                print(\"Ingrese un monto válido.\")\n",
        "\n",
        "        saldo_anterior = saldo\n",
        "        saldo += monto\n",
        "\n",
        "        operacion = {\n",
        "            \"tipo\": \"Depósito\",\n",
        "            \"monto\": monto,\n",
        "            \"saldo_anterior\": saldo_anterior,\n",
        "            \"saldo_nuevo\": saldo,\n",
        "            \"fecha\": datetime.now().strftime(\"%d/%m/%Y %H:%M:%S\"),\n",
        "            \"estado\": \"Aprobada\"\n",
        "        }\n",
        "\n",
        "        operaciones.append(operacion)\n",
        "\n",
        "        print(\"\\n✓ DEPÓSITO REALIZADO\")\n",
        "        print(f\"Monto depositado: S/ {monto:.2f}\")\n",
        "        print(f\"Nuevo saldo: S/ {saldo:.2f}\")\n",
        "\n",
        "    # RETIRO\n",
        "\n",
        "    elif opcion == \"2\":\n",
        "\n",
        "        while True:\n",
        "            try:\n",
        "                monto = float(input(\"Ingrese monto a retirar (S/): \"))\n",
        "\n",
        "                if monto > 0:\n",
        "                    break\n",
        "\n",
        "                print(\"El monto debe ser mayor que 0.\")\n",
        "\n",
        "            except ValueError:\n",
        "                print(\"Ingrese un monto válido.\")\n",
        "\n",
        "        saldo_anterior = saldo\n",
        "\n",
        "        # Verificación del saldo\n",
        "        if monto <= saldo:\n",
        "\n",
        "            saldo -= monto\n",
        "\n",
        "            estado = \"Aprobada\"\n",
        "\n",
        "            print(\"\\n✓ RETIRO REALIZADO\")\n",
        "            print(f\"Monto retirado: S/ {monto:.2f}\")\n",
        "            print(f\"Nuevo saldo: S/ {saldo:.2f}\")\n",
        "\n",
        "        else:\n",
        "\n",
        "            estado = \"Rechazada\"\n",
        "\n",
        "            print(\"\\n✗ OPERACIÓN RECHAZADA\")\n",
        "            print(\"Saldo insuficiente.\")\n",
        "\n",
        "        operacion = {\n",
        "            \"tipo\": \"Retiro\",\n",
        "            \"monto\": monto,\n",
        "            \"saldo_anterior\": saldo_anterior,\n",
        "            \"saldo_nuevo\": saldo,\n",
        "            \"fecha\": datetime.now().strftime(\"%d/%m/%Y %H:%M:%S\"),\n",
        "            \"estado\": estado\n",
        "        }\n",
        "\n",
        "        operaciones.append(operacion)\n",
        "\n",
        "    # CONSULTAR SALDO\n",
        "\n",
        "    elif opcion == \"3\":\n",
        "\n",
        "        print(\"\\n\" + \"-\" * 55)\n",
        "        print(\"              CONSULTA DE SALDO\")\n",
        "        print(\"-\" * 55)\n",
        "\n",
        "        print(f\"Cliente: {nombre}\")\n",
        "        print(f\"Cuenta: {cuenta}\")\n",
        "        print(f\"Saldo disponible: S/ {saldo:.2f}\")\n",
        "\n",
        "    # HISTORIAL DE OPERACIONES\n",
        "\n",
        "    elif opcion == \"4\":\n",
        "\n",
        "        print(\"\\n\" + \"=\" * 75)\n",
        "        print(\"                 HISTORIAL DE OPERACIONES\")\n",
        "        print(\"=\" * 75)\n",
        "\n",
        "        if len(operaciones) == 0:\n",
        "\n",
        "            print(\"No existen operaciones registradas.\")\n",
        "\n",
        "        else:\n",
        "\n",
        "            for i, op in enumerate(operaciones, start=1):\n",
        "\n",
        "                print(f\"\\nOperación N° {i}\")\n",
        "                print(f\"Tipo: {op['tipo']}\")\n",
        "                print(f\"Monto: S/ {op['monto']:.2f}\")\n",
        "                print(f\"Saldo anterior: S/ {op['saldo_anterior']:.2f}\")\n",
        "                print(f\"Saldo nuevo: S/ {op['saldo_nuevo']:.2f}\")\n",
        "                print(f\"Fecha: {op['fecha']}\")\n",
        "                print(f\"Estado: {op['estado']}\")\n",
        "\n",
        "    # ESTADÍSTICAS\n",
        "\n",
        "    elif opcion == \"5\":\n",
        "\n",
        "        print(\"\\n\" + \"=\" * 55)\n",
        "        print(\"             ESTADÍSTICAS BANCARIAS\")\n",
        "        print(\"=\" * 55)\n",
        "\n",
        "        # Solo operaciones aprobadas\n",
        "        aprobadas = [\n",
        "            op for op in operaciones\n",
        "            if op[\"estado\"] == \"Aprobada\"\n",
        "        ]\n",
        "\n",
        "        depositos = [\n",
        "            op[\"monto\"]\n",
        "            for op in operaciones\n",
        "            if op[\"tipo\"] == \"Depósito\"\n",
        "            and op[\"estado\"] == \"Aprobada\"\n",
        "        ]\n",
        "\n",
        "        retiros = [\n",
        "            op[\"monto\"]\n",
        "            for op in operaciones\n",
        "            if op[\"tipo\"] == \"Retiro\"\n",
        "            and op[\"estado\"] == \"Aprobada\"\n",
        "        ]\n",
        "\n",
        "        # Cálculos estadísticos\n",
        "        total_depositos = sum(depositos)\n",
        "        total_retiros = sum(retiros)\n",
        "\n",
        "        if len(aprobadas) > 0:\n",
        "\n",
        "            montos_aprobados = [\n",
        "                op[\"monto\"] for op in aprobadas\n",
        "            ]\n",
        "\n",
        "            promedio = sum(montos_aprobados) / len(montos_aprobados)\n",
        "            mayor = max(montos_aprobados)\n",
        "            menor = min(montos_aprobados)\n",
        "\n",
        "        else:\n",
        "\n",
        "            promedio = 0\n",
        "            mayor = 0\n",
        "            menor = 0\n",
        "\n",
        "        # Resultados\n",
        "        print(f\"Cantidad total de operaciones: {len(operaciones)}\")\n",
        "        print(f\"Operaciones aprobadas: {len(aprobadas)}\")\n",
        "        print(f\"Operaciones rechazadas: \"\n",
        "              f\"{len(operaciones) - len(aprobadas)}\")\n",
        "\n",
        "        print(f\"\\nTotal de depósitos: S/ {total_depositos:.2f}\")\n",
        "        print(f\"Total de retiros: S/ {total_retiros:.2f}\")\n",
        "\n",
        "        print(f\"\\nPromedio de operaciones: S/ {promedio:.2f}\")\n",
        "        print(f\"Mayor operación: S/ {mayor:.2f}\")\n",
        "        print(f\"Menor operación: S/ {menor:.2f}\")\n",
        "\n",
        "        print(f\"\\nSaldo actual: S/ {saldo:.2f}\")\n",
        "\n",
        "    # INFORMACIÓN DEL CLIENTE\n",
        "\n",
        "    elif opcion == \"6\":\n",
        "\n",
        "        print(\"\\n\" + \"=\" * 55)\n",
        "        print(\"             INFORMACIÓN DEL CLIENTE\")\n",
        "        print(\"=\" * 55)\n",
        "\n",
        "        print(f\"Nombre: {nombre}\")\n",
        "        print(f\"DNI: {dni}\")\n",
        "        print(f\"Número de cuenta: {cuenta}\")\n",
        "        print(f\"Saldo actual: S/ {saldo:.2f}\")\n",
        "\n",
        "    # SALIR\n",
        "\n",
        "    elif opcion == \"7\":\n",
        "\n",
        "        print(\"\\n\" + \"=\" * 55)\n",
        "        print(\"Gracias por utilizar el sistema bancario.\")\n",
        "        print(\"=\" * 55)\n",
        "\n",
        "        break\n",
        "\n",
        "    else:\n",
        "\n",
        "        print(\"\\nOpción no válida. Intente nuevamente.\")\n",
        "\n",
        "# 3. SALIDA FINAL\n",
        "\n",
        "print(\"\\n\" + \"=\" * 55)\n",
        "print(\"              RESUMEN FINAL\")\n",
        "print(\"=\" * 55)\n",
        "\n",
        "print(f\"Cliente: {nombre}\")\n",
        "print(f\"DNI: {dni}\")\n",
        "print(f\"Cuenta: {cuenta}\")\n",
        "print(f\"Saldo final: S/ {saldo:.2f}\")\n",
        "print(f\"Total de operaciones: {len(operaciones)}\")\n",
        "\n",
        "print(\"\\nSistema finalizado correctamente.\")"
      ]
    }
  ]
